# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Target Telegram Channel ID or @username (e.g. @KhmerCalendarDaily or -1001234567890)
# Make sure the bot is added as an Administrator in this channel with "Post Messages" permission.
CHANNEL_ID=@YourChannelUsernameOrId

# Cron schedule for daily broadcast (Default: 0 6 * * * -> 06:00 AM daily)
CRON_SCHEDULE=0 6 * * *

# Timezone (Default: Asia/Phnom_Penh UTC+7)
TIMEZONE=Asia/Phnom_Penh
